// Refer https://github.com/Alexays/Waybar/wiki/Configuration
// for official configuration docs

{
    // General configs
    "name": "TopBar",
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 8,
    "reload_style_on_change": true,

    // Modules positioning and declaration
    "modules-left": [
        "clock",
        "hyprland/workspaces",
        "custom/media"
    ],
    "modules-center": [
        "custom/logo"
    ],
    "modules-right": [
        "tray",
        "network",
        "bluetooth",
        "pulseaudio",
        "battery",
        "power-profiles-daemon",
        "custom/notifications",
        "custom/power"
    ],
    // Module definitions
    // Left modules
    "hyprland/workspaces": {
        "format": "{name}",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },
    "custom/media": {
        "format": "{}",
        "return-type": "json",
        "exec": "python3 $HOME/.config/waybar/scripts/media.py",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl volume 0.05+",
        "on-scroll-down": "playerctl volume 0.05-",
        "escape": false
    },
    "clock": {
        "format": " {0:%a, %b %d}    {0:%H:%M}",
        "timezone": "Asia/Kolkata",
        "on-click": "$HOME/.config/waybar/scripts/calendar_toggle.sh",
        "tooltip": false
    },
    // Center module
    "custom/logo": {
        "format": "  ",
        "tooltip": false,
        "on-click": "$HOME/.config/hypr/scripts/keybinds.sh"
    },
    // Right modules
    "network": {
        "format-wifi": " ",
        "format-ethernet": "󰈀 ",
        "format-disconnected": "󰖪 ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "tooltip-format-wifi": "{essid} ({signaldBm}dBm)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "kitty --class nmtui-float -e nmtui"
    },
    "bluetooth": {
        "format": "",
        "format-connected": "",
        "format-disconnected": "!",
        "format-disabled": "!",
        "format-connected-battery": " {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
        "on-click": "blueman-manager"
    },
    "pulseaudio": {
        "scroll-step": 1,
        "format": "{icon} {volume}%  {format_source}",
        "format-bluetooth": "{icon} {volume}%  {format_source}",
        "format-bluetooth-muted": "󰝟   {format_source}",
        "format-muted": "󰝟  {format_source}",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "default": [
                " ",
                " ",
                " "
            ]
        },
        "on-click": "pavucontrol",
        "tooltip-format": "{icon} {desc} | {volume}%"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "events": {
            "on-discharging-warning": "notify-send -u normal 'Low Battery'",
            "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
            "on-charging-100": "notify-send -u normal 'Battery Full!'"
        },
        "format": "{icon} {capacity}%",
        "format-full": "󰁹 Full",
        "format-charging": "󱐌 {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": false
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": " ",
            "performance": " ",
            "balanced": " ",
            "power-saver": " "
        }
    },
    "custom/notifications": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰂠",
            "dnd-none": "󰂠",
            "inhibited-notification": "󱅫",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂠",
            "dnd-inhibited-none": "󰂠"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "wlogout"
    }
}