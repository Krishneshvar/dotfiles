{
  "cssPriority": "user",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",

  "control-center-width": 380,
  "control-center-layer": "overlay",

  "notification-window-width": 360,
  "notification-icon-size": 48,

  "widgets": [
    "buttons-grid#toggles",
    "buttons-grid#actions",
    "volume",
    "backlight#screen",
    "mpris",
    "label#divider",
    "title",
    "dnd",
    "label#divider",
    "notifications"
  ],

  "widget-config": {
    "label#divider": {
      "text": ""
    },

    "title": {
      "text": "Notification Center",
      "clear-all-button": true,
      "button-text": "󰎟 Clear"
    },

    "dnd": {
      "text": "Do Not Disturb"
    },

    "volume": {
      "label": "󰕾 ",
      "show-per-app": true
    },

    "backlight#screen": {
      "label": "󰃠 ",
      "device": "intel_backlight",
      "min": 1
    },

    "mpris": {
      "image-size": 56,
      "image-radius": 10,
      "autohide": true,
      "blacklist": [
        "playerctld"
      ]
    },

    "buttons-grid#toggles": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "󰖩",
          "command": "nmcli radio wifi toggle",
          "type": "toggle",
          "update-command": "bash -c 'nmcli radio wifi | grep -q \"enabled\" && echo true || echo false'"
        },
        {
          "label": "󰂯",
          "command": "bash -c 'bluetoothctl power $(bluetoothctl show | grep -q \"Powered: yes\" && echo off || echo on)'",
          "type": "toggle",
          "update-command": "bash -c 'bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false'"
        },
        {
          "label": "󰝟",
          "command": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
          "type": "toggle",
          "update-command": "bash -c 'pactl get-sink-mute @DEFAULT_SINK@ | grep -q \"Mute: yes\" && echo true || echo false'"
        },
        {
          "label": "󰍬",
          "command": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
          "type": "toggle",
          "update-command": "bash -c 'pactl get-source-mute @DEFAULT_SOURCE@ | grep -q \"Mute: yes\" && echo true || echo false'"
        }
      ]
    },

    "buttons-grid#actions": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰈊",
          "command": "bash -c 'swaync-client -cp; sleep 0.15; hyprpicker -a -n'"
        },
        {
          "label": "󰑋",
          "command": "bash -c 'swaync-client -cp; gpu-screen-recorder-gtk &'"
        }
      ]
    }
  }
}