#!/bin/sh

BASE="$HOME/.config/wallengine"
THEMES_DIR="$HOME/Pictures/Wallpapers"
STATE_DIR="$BASE/state"

mkdir -p "$STATE_DIR"

reload_ui() {
    pgrep -x waybar >/dev/null 2>&1 && killall -SIGUSR2 waybar
    command -v swaync-client >/dev/null 2>&1 && swaync-client -R -rs
    pgrep -x kitty >/dev/null 2>&1 && killall -SIGUSR1 kitty
    pgrep -x swayosd-server >/dev/null 2>&1 && {
        killall swayosd-server
        swayosd-server >/dev/null 2>&1 &
    }
}

apply_wall() {
    WALL="$1"
    THEME="$2"

    [ ! -f "$WALL" ] && exit 1

    echo "$THEME" > "$STATE_DIR/current_theme"
    echo "$WALL" > "$STATE_DIR/current_wallpaper"

    case "$WALL" in
        *.gif|*.mp4|*.webm)
            FPS=30
            ;;
        *)
            FPS=60
            ;;
    esac

    awww img "$WALL" \
        --transition-type grow \
        --transition-duration 1 \
        --transition-fps "$FPS"

    if command -v matugen >/dev/null 2>&1; then
        matugen image "$WALL" --source-color-index 0
    fi

    reload_ui
    hyprctl reload >/dev/null 2>&1
}

random() {
    THEME_DIR=$(find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d | shuf -n 1)
    [ -z "$THEME_DIR" ] && exit 1
    THEME=$(basename "$THEME_DIR")
    WALL=$(find "$THEME_DIR" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" -o -iname "*.webp" -o -iname "*.gif" -o -iname "*.mp4" -o -iname "*.webm" \) | shuf -n 1)
    [ -z "$WALL" ] && exit 1
    apply_wall "$WALL" "$THEME"
}

set_theme() {
    THEME="$1"
    THEME_DIR="$THEMES_DIR/$THEME"
    if [ ! -d "$THEME_DIR" ]; then
        MATCH=$(find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -iname "$THEME" | head -n 1)
        [ -n "$MATCH" ] && THEME_DIR="$MATCH" && THEME=$(basename "$MATCH")
    fi
    [ ! -d "$THEME_DIR" ] && exit 1

    WALL=$(find "$THEME_DIR" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" -o -iname "*.webp" -o -iname "*.gif" -o -iname "*.mp4" -o -iname "*.webm" \) | shuf -n 1)
    [ -z "$WALL" ] && exit 1
    apply_wall "$WALL" "$THEME"
}

choose_theme() {
    LIST=""

    for DIR in "$THEMES_DIR"/*; do
        [ -d "$DIR" ] || continue

        THEME_NAME=$(basename "$DIR")

        # Use first image file as preview
        PREVIEW=$(find "$DIR" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" -o -iname "*.webp" \) | head -n 1)
        [ -z "$PREVIEW" ] && PREVIEW=$(find "$DIR" -maxdepth 1 -type f | head -n 1)

        LIST="${LIST}${THEME_NAME}\0icon\x1f${PREVIEW}\n"
    done

    CHOICE=$(printf "%b" "$LIST" | rofi -dmenu \
        -theme "$HOME/.config/rofi/wallpaper.rasi" \
        -p "󰉋 Theme" \
        -show-icons)

    [ -z "$CHOICE" ] && exit 0

    set_theme "$CHOICE"
}

choose_wallpaper() {
    THEME=$(cat "$STATE_DIR/current_theme" 2>/dev/null)
    if [ -n "$THEME" ] && [ ! -d "$THEMES_DIR/$THEME" ]; then
        MATCH=$(find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -iname "$THEME" | head -n 1)
        if [ -n "$MATCH" ]; then
            THEME=$(basename "$MATCH")
        else
            THEME=""
        fi
    fi

    if [ -z "$THEME" ]; then
        choose_theme
        exit 0
    fi

    COUNT=0
    LIST=""

    for WALL in "$THEMES_DIR/$THEME"/*; do
        [ -f "$WALL" ] || continue

        BASENAME=$(basename "$WALL")

        LIST="${LIST}${BASENAME}\0icon\x1f${WALL}\n"

        COUNT=$((COUNT+1))
        [ "$COUNT" -ge 300 ] && break
    done

    CHOICE=$(printf "%b" "$LIST" | rofi -dmenu \
        -theme "$HOME/.config/rofi/wallpaper.rasi" \
        -p "󰸉 $THEME" \
        -show-icons)

    [ -z "$CHOICE" ] && exit 0

    FULL_PATH="$THEMES_DIR/$THEME/$CHOICE"

    apply_wall "$FULL_PATH" "$THEME"
}

list() {
    find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -printf "%f\n"
}

current() {
    cat "$STATE_DIR/current_theme" 2>/dev/null
}

case "$1" in
    random) random ;;
    set) set_theme "$2" ;;
    choose-theme) choose_theme ;;
    choose-wall) choose_wallpaper ;;
    list) list ;;
    current) current ;;
    *) echo "Usage: themectl [random|set|choose-theme|choose-wall|list|current]" ;;
esac
