@import "base.rasi"

window {
    width: 620px;
}

mainbox {
    spacing: 0;
    background-color: transparent;
    children: [ "inputbar", "message", "listview" ];
}

inputbar {
    padding: 18px 20px 10px 20px;
    background-color: transparent;
    children: [ "entry" ];
}

entry {
    background-color: @bg-alt;
    text-color: @fg;

    placeholder: "  Search clipboard history...";
    placeholder-color: @fg-muted;

    padding: 12px 16px;
    border-radius: 100px;
}

message {
    padding: 0 20px 8px 20px;
    background-color: transparent;
}

textbox {
    padding: 6px 12px;
    background-color: transparent;
    text-color: @fg-muted;
    horizontal-align: 0.5;
}

listview {
    padding: 10px 20px 20px 20px;

    lines: 7;
    spacing: 8px;

    background-color: transparent;

    dynamic: true;
}

element {
    padding: 8px 14px;
    border-radius: 12px;

    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent;
    text-color: @on-accent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    background-color: transparent;
    size: 44px;
    margin: 0 12px 0 0;
    vertical-align: 0.5;
    border-radius: 6px;
}
