@import "base.rasi"

window {
    width: 680px;
}

mainbox {
    spacing: 0;
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

inputbar {
    padding: 18px 20px 10px 20px;
    background-color: transparent;
    children: [ "entry" ];
}

entry {
    background-color: @bg-alt;
    text-color: @fg;

    placeholder: "⌨  Search keybindings...";
    placeholder-color: @fg-muted;

    padding: 12px 16px;
    border-radius: 100px;
}

listview {
    padding: 10px 20px 20px 20px;

    lines: 9;
    spacing: 6px;

    background-color: transparent;
    dynamic: true;
}

element {
    padding: 10px 16px;
    border-radius: 12px;

    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent;
    text-color: @on-accent;
}

element-icon {
    size: 24px;
    margin: 0 12px 0 0;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    markup: true;
}
